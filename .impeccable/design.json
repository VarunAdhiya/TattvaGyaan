      "description": "Dashboard lamp-gold action with dark text and a lighter hover state.",
      "html": "<a class=\"ds-hero\" href=\"#library\">Explore the library <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-hero{display:inline-flex;align-items:center;gap:20px;min-height:50px;padding:14px 22px;background:#e9bc77;color:#302116;border-radius:5px;text-decoration:none;font-family:'Sacred Hind', 'Nirmala UI', sans-serif;font-size:15px;font-weight:600;transition:background .2s}.ds-hero:hover{background:#f6d69f}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-hero:focus-visible{outline:3px solid #d17219;outline-offset:4px;}"
    },
    {
      "name": "Account field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label, warm field and gold focus treatment.",
      "html": "<label class=\"ds-field-label\" for=\"ds-email\">Email Address</label><input class=\"ds-field\" id=\"ds-email\" type=\"email\" placeholder=\"your@email.com\"/>",
      "css": ".ds-field-label{display:block;margin-bottom:8px;font:500 15px/1.5 'Sacred Hind', 'Nirmala UI', sans-serif;color:#244d3e}.ds-field{font:400 16px/1.5 'Sacred Hind', 'Nirmala UI', sans-serif;min-height:48px;padding:10px 16px;background:#fffcf4;border:1px solid #d8c5a8;border-radius:5px;color:#1c1917;caret-color:#9b3225}.ds-field::placeholder{color:#786a54;opacity:1}.ds-field:focus,.ds-field:focus-visible{border-color:#b64b29;outline:2px solid #edc17b;outline-offset:2px;box-shadow:0 0 0 2px oklch(66.6% .179 58.318)}"
    },
    {
      "name": "Devotional navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Cream strip with a red current-page rule.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Devotional sections\"><a class=\"ds-tab\" href=\"#chalisas\" aria-current=\"page\">Chalisas</a><a class=\"ds-tab\" href=\"#bhajans\">Bhajans</a><a class=\"ds-tab\" href=\"#mantras\">Mantras</a></nav>",
      "css": ".ds-nav{display:flex;gap:30px;background:#fff6e3;border-bottom:1px solid #dcc9a7;padding:0 18px}.ds-tab{display:inline-flex;align-items:center;min-height:58px;padding:0 4px;border-bottom:3px solid transparent;color:#45584c;text-decoration:none;font:400 15px/1.5 'Sacred Hind', 'Nirmala UI', sans-serif;transition:color .2s,border-color .2s}.ds-tab:hover,.ds-tab[aria-current]{color:#a43827}.ds-tab[aria-current]{border-color:#b03d28;font-weight:600}.ds-tab:focus-visible{outline:2px solid #b45309;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
    {
      "name": "Complete availability badge",
      "kind": "chip",
      "refersTo": "chip-complete",
      "description": "Retained semantic Tailwind badge for a complete edition.",
      "html": "<span class=\"ds-complete\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m8 12 3 3 5-6\"/></svg>Complete</span>",
      "css": ".ds-complete{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border:1px solid oklch(90.5% .093 164.15);border-radius:9999px;background:oklch(95% .052 163.051);color:oklch(43.2% .095 166.913);font:500 12px/1.333333 'Sacred Hind', 'Nirmala UI', sans-serif}.ds-complete svg{color:oklch(59.6% .145 163.225)}"
    },
    {
      "name": "Devotional collection card",
      "kind": "card",
      "refersTo": "card-devotional",
      "description": "Title-led paper card with metadata below and a separated reading action.",
      "html": "<a class=\"ds-card\" href=\"#prayer\"><h2>Hanuman Chalisa</h2><p class=\"ds-hindi\" lang=\"hi\">?????? ??????</p><span class=\"ds-meta\">Hanuman</span><span class=\"ds-card-foot\">Read prayer <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span></a>",
      "css": ".ds-card{display:flex;flex-direction:column;position:relative;overflow:hidden;min-height:238px;padding:27px;background:#fffcf1;border:1px solid #cfbb94;border-radius:12px;text-decoration:none;font-family:'Sacred Hind', 'Nirmala UI', sans-serif;transition:transform .25s,border-color .25s}.ds-card h2{margin:0;color:#174638;font:500 23px/1.4 'Sacred Cinzel','Sacred Hind',serif}.ds-hindi{margin:8px 0 22px;color:#7e4828;font-size:21px;line-height:1.7}.ds-meta{margin-top:13px;color:#9a4225;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.ds-card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:15px;border-top:1px solid #dcc7a7;color:#a43a25;font-size:14px;font-weight:500}.ds-card:hover{transform:translateY(-4px);border-color:#a95c29}.ds-card:focus-visible{outline:2px solid #b45309;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
      "name": "Prayer language selection",
      "kind": "custom",
      "refersTo": "reader-language-selected",
      "description": "Saffron selected language on a dark prayer toolbar.",
      "html": "<div class=\"ds-languages\" role=\"group\" aria-label=\"Prayer language\"><button class=\"ds-language\" aria-pressed=\"true\">??????</button><button class=\"ds-language\" aria-pressed=\"false\">Transliteration</button></div>",
      "css": ".ds-languages{display:flex;gap:4px;padding:16px 22px;background:#123f37;border:1px solid #295749}.ds-language{padding:9px 14px;border:0;border-radius:6px;background:transparent;color:#fff1cc;font:400 15px/1.5 'Sacred Hind', 'Nirmala UI', sans-serif;cursor:pointer;transition:background-color .2s,color .2s}.ds-language[aria-pressed=true]{background:#f2b952;color:#1f392e}.ds-language:hover{color:#fff1cc}.ds-language[aria-pressed=true]:hover{color:#1f392e}.ds-language:focus-visible{outline:2px solid #b45309;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-language{transition:none}}"
    },
    {
      "name": "Dashboard prayer card content",
      "kind": "card",
      "refersTo": "card-dashboard",
      "description": "Text portion of a dark dashboard prayer card; the live card places a complete 3:2 deity image above it.",
      "html": "<article class=\"ds-dashboard-card\"><a class=\"ds-dashboard-main\" href=\"#hanuman-chalisa\"><h3>Hanuman Chalisa</h3><p>A devotional hymn in praise of Hanuman.</p><span>Read chalisa</span></a><a class=\"ds-dashboard-browse\" href=\"#chalisas\">Browse all chalisas</a></article>",
      "css": ".ds-dashboard-card{background:#24201b;border:1px solid #d6b77e29;border-radius:12px;overflow:hidden;font-family:\"Sacred Hind\",\"Nirmala UI\",sans-serif}.ds-dashboard-main{display:flex;flex-direction:column;padding:22px 24px 20px;text-decoration:none}.ds-dashboard-main h3{margin:0;color:#fff0d8;font:500 29px/1.15 \"Tattva Cormorant\",Georgia,serif}.ds-dashboard-main p{font-size:15px;line-height:1.65;color:#d5c7b3;margin:14px 0 20px}.ds-dashboard-main span{color:#efc789;font-size:14px}.ds-dashboard-browse{display:flex;padding:15px 24px;border-top:1px solid #d6b77e29;color:#d5c7b3;font-size:13px;text-decoration:none}.ds-dashboard-main:hover h3,.ds-dashboard-browse:hover{color:#ffd492}.ds-dashboard-card:focus-within{outline:2px solid #e9bc77;outline-offset:4px}.ds-dashboard-card a:focus-visible{outline:2px solid #e9bc77;outline-offset:-2px}"
    }
  ],
  "narrative": {
    "northStar": "The Temple Reading Sanctuary",
    "overview": "A saturated temple-green and vermilion interface frames warm paper, saffron accents, and the supplied temple, river, Himalayan mountain and sage artwork. Cinzel gives navigation and headings a ceremonial character; Hind keeps controls and bilingual interface copy approachable. Collection screens carry ornament at their edges while scripture remains on quiet, selectable paper.\n\nThis is the implemented October 2026 visual system. The dashboard has a distinct continuous warm-charcoal treatment, sentence-case Cormorant headings, Hind interface text and complete deity illustrations. Its restrained gold accents connect it to the other routes without changing their green, vermilion and paper palette. Reading has its own calibrated type and user-selected paper themes.",
    "keyCharacteristics": [
      "Bold temple green, vermilion and saffron against cream paper.",
      "Ceremonial display type paired with clear Hindi-capable interface text.",
      "Supplied artwork and peripheral lotus geometry; quiet reading surfaces.",
      "Fine borders, restrained hover lift and reduced-motion support.",
      "A route-scoped charcoal dashboard with sentence-case Cormorant and uncropped artwork."
    ],
    "rules": [
      {
        "name": "The Quiet Paper Rule",
        "body": "Keep sustained scripture and prayer reading on its own paper surface; place saturated color and ornament around the reading area.",
        "section": "colors"
      },
      {
        "name": "The Reading Type Rule",
        "body": "Preserve the reader font stacks, user size controls, line heights and pagination measurements independently of interface typography.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Use fine borders and tonal contrast for ordinary panels; reserve dimensional paper, binding and stand effects for the book reader.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the supplied temple artwork and original lotus ornament with the source record in frontend/src/assets/landing/README.md.",
      "Do retain distinct display, interface, prayer and scripture type roles.",
      "Do keep metadata below titles and retain truthful availability labels.",
      "Do provide visible keyboard focus, readable selected states and the reduced-motion behavior already implemented.",
      "Do inspect the final CSS cascade before extending components that still carry Tailwind utilities.",
      "Do preserve the dashboard's complete Durga, Ganesha and prayer illustrations without blur, recompression or cover cropping."
    ],
    "donts": [
      "Don't apply interface fonts or a global color override to calibrated scripture pages.",
      "Don't extend the dashboard's Cormorant and charcoal palette to other routes without a separate design decision.",
      "Don't reintroduce oversized all-capital dashboard headings, cropped Ganesha artwork or cream section slabs.",
      "Don't place decorative artwork behind sustained scripture text.",
      "Don't turn remaining ornamental glyphs or legacy eyebrow selectors into reusable navigation icons or heading patterns."
    ]
  }
}
