DATABASE_URL="postgresql://postgres:varun@localhost:5432/TattvaGyaan?schema=public"
# Each API process uses at most 5 query connections and 2 session connections.
# Keep the total across running processes below the provider's pool size.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=15
SESSION_DATABASE_CONNECTION_LIMIT=2
SESSION_SECRET="dev-secret-change-in-production-tattvagyaan"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_MS=90000
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=90000
# Search embeddings run locally; no second API key is needed.
# Run npm run rag:index after migrations or source-text changes.
CORS_ORIGIN="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Google Cloud OAuth client (Web application). Keep the secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
